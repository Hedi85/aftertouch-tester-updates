                   <string notr="true">/* Hide default radio dot */
QRadioButton::indicator {
    width: 0;
    height: 0;
}

/* Base (unselected) */
QRadioButton {
    padding: 3px 14px;
    min-height: 16px;
    border-radius: 8px;
    border: 1px solid #d0d0d0;
    background-color: #f5f5f5;
    color: #333;
    font-weight: 600;
    font-size: 13px;
}

/* Hover */
QRadioButton:hover {
    background-color: #ededed;
}

/* Selected (ORANGE) */
QRadioButton#two_sw:checked,
QRadioButton#three_sw:checked {
    background-color: #fff4e5;
    border: 1.5px solid #FFA500;
    color: #000;
}
