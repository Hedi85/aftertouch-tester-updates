                   <widget class="QRadioButton" name="radioAcoustic">
                    <property name="styleSheet">
                     <string notr="true">/* Hide the default radio circle */
QRadioButton::indicator {
    width: 0;
    height: 0;
}

/* Base style */
QRadioButton {
    padding: 8px 18px;
    border-radius: 10px;
    border: 2px solid #FFA500;
    background-color: transparent;
    color: #FFA500;
    font-weight: bold;
    min-width: 110px;
    text-align: center;
}

/* Hover effect */
QRadioButton:hover {
    background-color: rgba(255, 165, 0, 0.15);
}

/* Checked = Electrical (Orange) */
QRadioButton#radioElectrical:checked {
    background-color: #FFA500;
    color: white;
    border: 2px solid #FFA500;
}

/* Checked = Acoustic (Green) */
QRadioButton#radioAcoustic:checked {
    background-color: #10B981;
    color: white;
    border: 2px solid #10B981;
}
</string>
                    </property>
                    <property name="text">
                     <string>ACOUSTIC TEST  </string>
                    </property>
