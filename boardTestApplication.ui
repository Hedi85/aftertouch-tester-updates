                 <widget class="QCheckBox" name="checkBoxresplit">
                  <property name="font">
                   <font>
                    <pointsize>8</pointsize>
                    <weight>75</weight>
                    <bold>true</bold>
                   </font>
                  </property>
                  <property name="styleSheet">
                   <string notr="true">QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #ccc;
    border-radius: 3px;
    background: white;
}

QCheckBox::indicator:checked {
    image: none;
    border: 2px solid #4CAF50;
    background-color: #4CAF50;
}

QCheckBox::indicator:checked::before {
    content: &quot;✓&quot;;
    color: white;
    font-weight: bold;
    position: absolute;
    left: 3px;
    top: -1px;
    font-size: 14px;
}
</string>
                  </property>
                  <property name="text">
                   <string>Split Black and White Keys</string>
                  </property>
                  <property name="iconSize">
                   <size>
                    <width>16</width>
                    <height>16</height>
                   </size>
                  </property>
                  <property name="checked">
                   <bool>true</bool>
                  </property>
                 </widget>
                </item>
               </layout>
