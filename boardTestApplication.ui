               <property name="styleSheet">
                <string notr="true">/* Groove styling - matches the original button */
QSlider::groove:vertical {
    border: 1px solid black; /* Matches button border */
    width: 29px; /* Double the standard groove width */
    margin: 0px; /* Covers the entire slider area */
    background-color: transparent;
}

/* Add page styling (below the handle) - Yellow gradient to represent the active value */
QSlider::add-page:vertical {
    background: qlineargradient(
        spread:pad, x1:0, y1:1, x2:1, y2:0,
        stop:0 rgba(255, 255, 102, 255), /* Light Yellow */
        stop:1 rgba(255, 204, 0, 255)    /* Darker Yellow */
    );
    border: 1px solid black; /* Matches the button's border */
}

/* Sub page styling (above the handle) - Gradient to match the original button */
QSlider::sub-page:vertical {
    background: qlineargradient(
        spread:pad, x1:1, y1:0.711, x2:0.903455, y2:0.711,
        stop:0 rgba(0, 0, 0, 255), /* Black gradient start */
        stop:1 rgba(255, 255, 255, 255) /* Gradient end to white */
    );
    border: 1px solid black; /* Matches the button's border */
}

/* Handle styling */
QSlider::handle:vertical {
    background: none;
    width: 29px;  /* Full width of the groove */
    height: 5px;  /* Small horizontal line for the handle */
    margin: -2px 0; /* Centers the handle on the groove */
    border-radius: 0; /* No rounded corners for a button-like shape */
    background-color: transparent;
    border: 1px solid black; /* Matching the button's border */
    margin: -5px 0;
}
