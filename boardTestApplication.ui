              <widget class="QSlider" name="v_gain_slider_2">
               <property name="geometry">
                <rect>
                 <x>130</x>
                 <y>290</y>
                 <width>16</width>
                 <height>101</height>
                </rect>
               </property>
               <property name="styleSheet">
                <string notr="true">/* === Groove === */
QSlider::groove:vertical {
    width: 14px;
    border-radius: 7px;
    background: rgba(255, 140, 0, 0.15);  /* soft orange glow */
    margin: 4px 0;
}

/* === Filled Part (active section) === */
QSlider::sub-page:vertical {
    background: qlineargradient(
        x1:0, y1:1, x2:0, y2:0,
        stop:0 #ffb84d,
        stop:0.5 #ff9a1f,
        stop:1 #ff6b00
    );
    border-radius: 7px;
    box-shadow: 0 0 8px rgba(255, 140, 0, 0.4);
}

/* === Empty Part === */
QSlider::add-page:vertical {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 7px;
}

/* === Smaller Handle === */
QSlider::handle:vertical {
    background: qradialgradient(
        cx:0.5, cy:0.5, radius:0.8,
        stop:0 #fff,
        stop:1 #ff8c00
    );
    border: 1px solid #ff8c00;
    width: 10px;
    height: 6px;              /* smaller horizontal bar */
    border-radius: 3px;
    margin: -3px -3px;
    transition: all 0.2s ease-in-out;
}

QSlider::handle:vertical:hover {
    background: qradialgradient(
        cx:0.5, cy:0.5, radius:0.8,
        stop:0 #fff,
        stop:1 #ffaa33
    );
    box-shadow: 0 0 6px rgba(255, 140, 0, 0.6);
}

/* === Optional: Matching LineEdit === */
QLineEdit {
    font-size: 16px;
    border: 2px solid #ff9a1f;
    border-radius: 8px;
    background-color: #fffaf2;
    color: #333;
    padding: 4px 8px;
}
</string>
               </property>
               <property name="minimum">
                <number>40</number>
               </property>
               <property name="maximum">
                <number>200</number>
               </property>
               <property name="orientation">
                <enum>Qt::Vertical</enum>
               </property>
              </widget>
