             <widget class="QPushButton" name="clear_notes">
              <property name="geometry">
               <rect>
                <x>950</x>
                <y>780</y>
                <width>161</width>
                <height>41</height>
               </rect>
              </property>
              <property name="styleSheet">
               <string notr="true">QPushButton {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff,
        stop:0.5 rgba(255, 200, 150, 0.3),
        stop:1 rgba(255, 180, 80, 0.2)
    );
    border: 2px solid rgba(255, 165, 0, 0.4);
    border-radius: 12px;
    color: #333;
    font-weight: 600;
    font-size: 12px;
    padding: 8px 20px;
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.3);
    transition: all 0.2s ease-in-out;
}

/* Simulate outer glow layer */
QPushButton::before {
    content: &quot;&quot;;
    border-radius: 16px;
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.7),
        stop:1 rgba(255, 180, 80, 0.15)
    );
}

/* Hover effect: warmer orange and deeper glow */
QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #fff5e6,
        stop:1 rgba(255, 150, 0, 0.4)
    );
    border: 2px solid rgba(255, 140, 0, 0.7);
    color: #000;
    box-shadow: 0 0 10px rgba(255, 165, 0, 0.6);
}

/* Pressed (active) effect */
QPushButton:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 200, 100, 0.8),
        stop:1 rgba(255, 150, 0, 0.6)
    );
    box-shadow: 0 0 4px rgba(255, 120, 0, 0.5);
    transform: scale(0.98);
}

/* Focus ring effect */
QPushButton:focus {
    outline: none;
    border: 2px solid #ff8800;
}
</string>
              </property>
