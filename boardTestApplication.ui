               <layout class="QGridLayout" name="gridLayout_8">
                <item row="0" column="0">
                 <widget class="QRadioButton" name="dynamic_radio">
                  <property name="styleSheet">
                   <string notr="true">/* Hide default radio indicator */
QRadioButton::indicator {
    width: 0;
    height: 0;
}

/* Base style */
QRadioButton {
    padding: 3px 14px;
    min-height: 16px;
    border-radius: 8px;
    border: 1px solid #d0d0d0;
    background-color: #f8f8f8;
    color: #333;
    font-size: 13px;
    font-weight: 600;
}

/* Hover state */
QRadioButton:hover {
    background-color: #f0f0f0;
}

/* Checked (orange highlight) */
QRadioButton:checked {
    background-color: #fff2e0;
    border: 1.5px solid #ff9800;
    color: #222;
    padding-left: 16px;   /* tiny shift = premium look */
    transition: 0.15s;
}
</string>
                  </property>
                  <property name="text">
                   <string>Dynamic Only</string>
                  </property>
                 </widget>
                </item>
