                  <property name="styleSheet">
                   <string notr="true">QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #ccc;
    border-radius: 3px;
    background: white;
}

QCheckBox::indicator:checked {
    image: none;
    border: 2px solid #4CAF50;
    background-color: #4CAF50;
}

QCheckBox::indicator:checked::before {
    content: &quot;✓&quot;;
    color: white;
    font-weight: bold;
    position: absolute;
    left: 3px;
    top: -1px;
    font-size: 14px;
}
</string>
