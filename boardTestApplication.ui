}

/* Dynamic color change as value increases */
QSlider::add-page:vertical:active {
    background: qlineargradient(
        spread:pad, x1:0.028, y1:0.619, x2:1, y2:0.494,
        stop:0.852273 rgba(0, 100, 0, 250), /* Dark green as value increases */
        stop:1 rgba(0, 255, 0, 255) /* Bright green transition */
    );
}
</string>
