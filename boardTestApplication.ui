               <property name="styleSheet">
                <string notr="true">/* Groove styling */
QSlider::groove:vertical {
    border: 1px solid black; /* Matches the button border */
    width: 20px;
    margin: 0px;
    background: transparent;
}

/* Handle styling */
QSlider::handle:vertical {
    background: none;
    width: 20px;
    height: 5px;
    margin: -2px 0;
    border-radius: 0;
    background-color: transparent;
    border: 1px solid black; /* Matches the button border */
	 margin: -5px 0;
}

/* Add-page (above the handle) - Initial style similar to button */
QSlider::add-page:vertical {
    background: qlineargradient(
        spread:pad, x1:0.028, y1:0.619, x2:1, y2:0.494,
        stop:0.852273 rgba(0, 150, 0, 250), /* Matches initial button color */
        stop:1 rgba(255, 255, 255, 255)
    );
    border: 1px solid black; /* Matches the button border */
}

/* Sub-page (below the handle) - Initial style, solid black */
QSlider::sub-page:vertical {
    background: black;
    border: 1px solid black;
}

/* Dynamic color change as value increases */
QSlider::add-page:vertical:active {
    background: qlineargradient(
        spread:pad, x1:0.028, y1:0.619, x2:1, y2:0.494,
        stop:0.852273 rgba(0, 100, 0, 250), /* Dark green as value increases */
        stop:1 rgba(0, 255, 0, 255) /* Bright green transition */
    );
}
